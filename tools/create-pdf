#!/usr/bin/env python3
"""create-pdf <subject>: export every note in a subject's Notes folder in the Obsidian vault as its own PDF.

  create-pdf "Lineare Algebra"   -> ~/Levi/Main/Local/Github/notes/Lineare Algebra/*.pdf,
                                    rebuilds the website pages, commits and pushes to GitHub
  create-pdf Analysis --no-push  -> export and rebuild pages, but do not commit/push
  create-pdf Analysis -o ~/Desktop/pdfs -> plain export to another folder (no website, no push)
  create-pdf all                 -> every subject, one commit and one push
  create-pdf                     -> lists the subjects

Needs: pandoc, xelatex (texlive-xetex), pdftoppm/pdfinfo (poppler).
Obsidian PDF embeds (![[file.pdf#page=3&rect=l,b,r,t]]) are rendered as images, like Obsidian's own export.
"""
import argparse, html, os, re, shutil, subprocess, sys, tempfile
from urllib.parse import quote
from pathlib import Path

VAULT = Path.home() / "Levi/Main/Local/Obsidian Vault"
REPO = Path(__file__).resolve().parent.parent  # the "notes" repo this script lives in
SITE_URL = "https://flowerjoke.github.io/notes/"
SKIP_DIRS = {".git", ".obsidian", ".trash", ".claude", ".opencode", ".copilot", "copilot", "node_modules"}
DPI = 150

EMBED = re.compile(r"!\[\[([^\]\n]+?)\]\]")
LINK = re.compile(r"\[\[([^\]\n]+?)\]\]")


def die(msg):
    print(f"create-pdf: {msg}", file=sys.stderr)
    sys.exit(1)


def subjects():
    out = {}
    for sem in sorted(VAULT.glob("Semester*")):
        for d in sorted(p for p in sem.iterdir() if p.is_dir()):
            out[d.name] = d
    return out


def find_subject(name):
    subs = subjects()
    exact = [n for n in subs if n.lower() == name.lower()]
    hits = exact or [n for n in subs if name.lower() in n.lower()]
    if len(hits) != 1:
        die(("no subject matches '%s'" if not hits else "'%s' is ambiguous") % name
            + ". Subjects: " + ", ".join(subs))
    return hits[0], subs[hits[0]]


_index = None


def vault_index():
    global _index
    if _index is None:
        _index = {}
        for root, dirs, files in os.walk(VAULT):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            for f in files:
                _index.setdefault(f.lower(), []).append(Path(root) / f)
    return _index


def resolve(target, near):
    """Find a vault file for an Obsidian link target (path or bare name)."""
    p = VAULT / target
    for cand in (p, p.with_suffix(".md")):
        if cand.is_file():
            return cand
    name = Path(target).name.lower()
    cands = vault_index().get(name) or vault_index().get(name + ".md") or []
    if not cands:
        return None
    cands.sort(key=lambda c: (near not in c.parents, len(str(c))))
    return cands[0]


def render_pdf(pdf, page, rect, tmp, cache):
    key = (pdf, page, rect)
    if key in cache:
        return cache[key]
    info = subprocess.run(["pdfinfo", "-f", str(page), "-l", str(page), str(pdf)],
                          capture_output=True, text=True).stdout
    m = re.search(r"Page\s+%d size:\s+([\d.]+) x ([\d.]+)" % page, info)
    args = ["pdftoppm", "-f", str(page), "-l", str(page), "-r", str(DPI), "-png", "-singlefile"]
    if rect and m:
        h = float(m.group(2))
        l, b, r, t = rect
        l, r = min(l, r), max(l, r)
        b, t = min(b, t), max(b, t)
        s = DPI / 72
        args += ["-x", str(int(l * s)), "-y", str(int((h - t) * s)),
                 "-W", str(max(1, int((r - l) * s))), "-H", str(max(1, int((t - b) * s)))]
    out = tmp / f"pdf{len(cache)}"
    r = subprocess.run(args + [str(pdf), str(out)], capture_output=True)
    res = str(out) + ".png" if r.returncode == 0 and Path(str(out) + ".png").is_file() else None
    cache[key] = res
    return res


def convert(text, note, ctx, depth=0):
    text = re.sub(r"\A---\n.*?\n---\n", "", text, flags=re.S)  # frontmatter
    text = re.sub(r"%%.*?%%", "", text, flags=re.S)             # obsidian comments
    text = text.replace("🡢", "→").replace("🡠", "←")

    def embed(m):
        raw = m.group(1)
        target, _, alias = raw.partition("|")
        base, _, frag = target.partition("#")
        f = resolve(base, note.parent) if base else None
        if f is None:
            ctx["warn"].append(f"{note.name}: not found: {base}")
            return f"*[{base} not found]*"
        suf = f.suffix.lower()
        if suf == ".pdf":
            pm = re.search(r"page=(\d+)", frag)
            rm = re.search(r"rect=(-?[\d.]+),(-?[\d.]+),(-?[\d.]+),(-?[\d.]+)", frag)
            if not pm:
                return f"*[{f.name}]*"
            img = render_pdf(f, int(pm.group(1)), tuple(map(float, rm.groups())) if rm else None,
                             ctx["tmp"], ctx["cache"])
            if img is None:
                ctx["warn"].append(f"{note.name}: could not render {f.name} p.{pm.group(1)}")
                return f"*[{f.name}, p.{pm.group(1)}]*"
            return f"\n\n![]({img}){{width=100%}}\n\n"
        if suf in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"):
            return f"\n\n![]({f}){{width=100%}}\n\n"
        if suf == ".md" and depth < 2:
            return "\n\n" + convert(f.read_text(encoding="utf-8"), f, ctx, depth + 1) + "\n\n"
        return f"*[{f.name}]*"

    # MathJax accepts $$ \begin{align}..\end{align} $$, LaTeX does not: drop the $$ and use the unnumbered form
    text = re.sub(r"\$\$\s*\\begin\{(align|alignat|gather|multline|flalign|eqnarray)\*?\}(.*?)\\end\{\1\*?\}\s*\$\$",
                  lambda m: f"\n\\begin{{{m.group(1)}*}}{m.group(2)}\\end{{{m.group(1)}*}}\n", text, flags=re.S)
    text = EMBED.sub(embed, text)
    text = LINK.sub(lambda m: (m.group(1).split("|")[-1] if "|" in m.group(1)
                               else m.group(1).split("#")[0].split("/")[-1]), text)
    # callouts: "> [!note] Title" -> quote with bold title
    text = re.sub(r"^(>\s*)\[!(\w+)\][+-]?\s*(.*)$",
                  lambda m: f"{m.group(1)}**{m.group(3) or m.group(2).capitalize()}**", text, flags=re.M)
    text = re.sub(r"==(.+?)==", r"\1", text)                    # highlights
    text = re.sub(r"([^\n])\n(#{1,6}[ \t])", r"\1\n\n\2", text)  # Obsidian lets a heading follow a line directly
    return text


