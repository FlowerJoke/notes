def page(title, body, depth):
    return (f'<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<title>{html.escape(title)}</title><style>{CSS}</style></head><body><main>{body}</main></body></html>')


def build_site(repo):
    """Landing page + one page per subject + README, generated from the PDFs in the repo."""
    subs = {}
    for d in sorted(p for p in repo.iterdir() if p.is_dir() and not p.name.startswith(".")):
        pdfs = sorted(d.glob("*.pdf"))
        if pdfs:
            subs[d.name] = pdfs
    cards = "".join(f'<a class="card" href="{quote(n)}/">{html.escape(n)}<small>{len(f)} Notizen</small></a>' for n, f in subs.items())
    (repo / "index.html").write_text(page("Notizen", f'<h1>Notizen</h1><div class="grid">{cards}</div>', 0), encoding="utf-8")
    readme = ["# Notizen\n", "HM Informatik, Semester 1. Mitschriften als PDF.\n",
              f"Website mit Fächerübersicht: {SITE_URL}\n"]
    for n, files in subs.items():
        rows = "".join(
            f'<div class="row"><span>{html.escape(f.stem)}</span><span class="acts"><a href="{quote(f.name)}">Ansehen</a>'
            f'<a href="{quote(f.name)}" download>Herunterladen</a></span></div>' for f in files)
        (repo / n / "index.html").write_text(page(n, f'<a class="back" href="../">← Alle Fächer</a><h1>{html.escape(n)}</h1><p class="sub">{len(files)} Notizen</p><div class="grid">{rows}</div>', 1), encoding="utf-8")
        readme.append(f"\n## {n}\n")
        readme += [f"- [{f.stem}]({quote(n)}/{quote(f.name)})" for f in files]
    (repo / "README.md").write_text("\n".join(readme), encoding="utf-8")


def publish(repo, subject):
    git = ["git", "-C", str(repo)]
    subprocess.run(git + ["add", "-A"], check=True)
    if subprocess.run(git + ["diff", "--cached", "--quiet"]).returncode == 0:
        print("nothing changed, nothing to push")
        return
    subprocess.run(git + ["commit", "-q", "-m", f"{subject}: Notizen aktualisiert"], check=True)
    r = subprocess.run(git + ["push", "-q", "-u", "origin", "main"])
    print("pushed to GitHub" if r.returncode == 0 else "PUSH FAILED (the commit is saved locally)")


def export(name, folder, out):
    """Export one subject's Notes folder. Returns the number of PDFs made (None if there are no notes)."""
    notes_dir = folder / "Notes"
    notes = sorted(p for p in notes_dir.rglob("*.md")
                   if not any(part.startswith(".") for part in p.relative_to(notes_dir).parts)) if notes_dir.is_dir() else []
    if not notes:
        print(f"{name}: no notes in {notes_dir}, skipped")
        return None
    out.mkdir(parents=True, exist_ok=True)
    names = [n.stem for n in notes]
    ctx = {"warn": [], "cache": {}}
    ok = 0
    made = set()
    print(f"== {name}")
    with tempfile.TemporaryDirectory() as t:
        ctx["tmp"] = Path(t)
        for n in notes:
            stem = n.stem if names.count(n.stem) == 1 else f"{n.parent.name} - {n.stem}"
            md = Path(t) / "note.md"
            body = convert(n.read_text(encoding="utf-8"), n, ctx)
            if not body.strip():
                print(f"  skip (empty note): {n.name}")
                continue
            md.write_text(body, encoding="utf-8")
            pdf = out / f"{stem}.pdf"
            r = subprocess.run(
                ["pandoc", str(md), "-f", "markdown+hard_line_breaks+tex_math_dollars-yaml_metadata_block",
                 "-o", str(pdf), "--pdf-engine=xelatex",
                 "-V", "geometry:margin=2cm", "-V", "fontsize=11pt",
                 "-M", f"title={stem}"],
                capture_output=True, text=True)
            if r.returncode == 0:
                ok += 1
                made.add(pdf.name)
                print(f"  ok  {pdf.name}")
            else:
                print(f"FAIL  {n.name}: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else 'pandoc error'}")
    for old in sorted(out.glob("*.pdf")):
        if old.name not in made:
            subprocess.run(["gio", "trash", str(old)])
            print(f"  removed (note no longer exists): {old.name}")
    for w in ctx["warn"]:
        print("  warn", w)
    print(f"{ok}/{len(notes)} PDFs in {out}")
    return ok


def main():
    ap = argparse.ArgumentParser(description="Export every note of a subject as its own PDF.")
    ap.add_argument("subject", nargs="?", help='subject name, or "all" for every subject')
    ap.add_argument("-o", "--out", help="plain export to this folder (no website pages, no push; single subject only)")
    ap.add_argument("--no-push", action="store_true", help="export and rebuild the pages, but do not commit or push")
    a = ap.parse_args()
    if not a.subject:
        print("Subjects:\n  " + "\n  ".join(subjects()) + "\n\nUse: create-pdf <subject>   or   create-pdf all")
        return
    for tool in ("pandoc", "pdftoppm", "xelatex"):
        if not shutil.which(tool):
            die(f"'{tool}' is not installed")
    if a.subject.lower() == "all":
        if a.out:
            die("-o works with a single subject only")
        results = [export(n, f, REPO / n) for n, f in subjects().items()]
        label = "alle Fächer"
        ok = sum(r or 0 for r in results)
    else:
        name, folder = find_subject(a.subject)
        out = Path(a.out).expanduser() if a.out else REPO / name
        ok = export(name, folder, out)
        if ok is None:
            die(f"no notes in {folder / 'Notes'}")
        label = name
    if not a.out and ok:
        build_site(REPO)
        if not a.no_push:
            publish(REPO, label)


if __name__ == "__main__":
    main()
