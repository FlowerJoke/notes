#!/usr/bin/env python3
"""sync-laborbuch: copy the Laborbuch READMEs (repo -> targets, never back).

  sync-laborbuch             -> Obsidian vault copy + PDF on the website, commit and push
  sync-laborbuch --no-push   -> same, but do not commit or push
  sync-laborbuch --vault-only -> only the Obsidian copy (private), no PDF, no website

Every run also installs a pre-push hook in each Laborbuch repo: `git push` to GitLab then runs this script.

Source:  ~/Levi/Main/Local/Studium/Grundlagen der Rechnersysteme/laborbuch-N_*/{README.md,images/}
Vault:   <vault>/Semester 1/Grundlagen der Rechnersysteme/Laborbuch/Laborbuch N/{README.md,images/}
Website: <notes repo>/Grundlagen der Rechnersysteme/Laborbuch/Laborbuch N.pdf (images embedded)
"""
import argparse, importlib.machinery, importlib.util, re, shutil, subprocess, sys, tempfile
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("create_pdf", str(HERE / "create-pdf"))
cp = importlib.util.module_from_spec(importlib.util.spec_from_loader("create_pdf", loader))
loader.exec_module(cp)  # reuse VAULT, REPO, build_site, publish

FACH = "Grundlagen der Rechnersysteme"
SRC = Path.home() / "Levi/Main/Local/Studium" / FACH
VAULT_DIR = cp.VAULT / "Semester 1" / FACH / "Laborbuch"
SITE_DIR = cp.REPO / FACH / "Laborbuch"


def die(msg):
    print(f"sync-laborbuch: {msg}", file=sys.stderr)
    sys.exit(1)


HOOK_MARK = "# managed by sync-laborbuch"
HOOK = f"""#!/bin/sh
{HOOK_MARK}: copies the README to the vault and publishes it. Never blocks the push.
"{HERE / 'sync-laborbuch'}" >&2 || echo "sync-laborbuch failed (push continues)" >&2
exit 0
"""


def install_hook(repo):
    """pre-push hook in the Laborbuch repo, so every push to GitLab also syncs the vault and the website."""
    hook = repo / ".git" / "hooks" / "pre-push"
    if not hook.parent.is_dir():
        return
    if hook.exists() and HOOK_MARK not in hook.read_text(encoding="utf-8"):
        print(f"  warn  {repo.name}: foreign pre-push hook exists, not touched")
        return
    if not hook.exists() or hook.read_text(encoding="utf-8") != HOOK:
        hook.write_text(HOOK, encoding="utf-8")
        hook.chmod(0o755)
        print(f"  hook   installed in {repo.name}")


def make_pdf(readme, title, pdf):
    """pandoc README -> PDF; relative image links resolve against the README's folder."""
    r = subprocess.run(
        ["pandoc", str(readme), "-f", "gfm+tex_math_dollars+hard_line_breaks", "-o", str(pdf),
         "--pdf-engine=xelatex", "--resource-path", str(readme.parent),
         "-V", "geometry:margin=2cm", "-V", "fontsize=11pt", "-M", f"title={title}"],
        capture_output=True, text=True)
    return r.returncode == 0, (r.stderr.strip().splitlines() or ["pandoc error"])[-1]


def main():
    ap = argparse.ArgumentParser(description="Copy the Laborbuch READMEs into the vault and onto the website.")
    ap.add_argument("--no-push", action="store_true", help="do everything but do not commit or push")
    ap.add_argument("--vault-only", action="store_true", help="only copy into the Obsidian vault (nothing public)")
    a = ap.parse_args()
    if not a.vault_only:
        for tool in ("pandoc", "xelatex"):
            if not shutil.which(tool):
                die(f"'{tool}' is not installed")
    repos = sorted((p for p in SRC.glob("laborbuch-*_*") if (p / "README.md").is_file()),
                   key=lambda p: int(re.match(r"laborbuch-(\d+)", p.name).group(1)))
    if not repos:
        die(f"no laborbuch-N_* repos with a README.md in {SRC}")
    made = set()
    for repo in repos:
        n = re.match(r"laborbuch-(\d+)", repo.name).group(1)
        title = f"Laborbuch {n}"
        install_hook(repo)
        dst = VAULT_DIR / title
        dst.mkdir(parents=True, exist_ok=True)
        shutil.copy2(repo / "README.md", dst / "README.md")
        if (repo / "images").is_dir():
            shutil.copytree(repo / "images", dst / "images", dirs_exist_ok=True)
        print(f"  vault  {title}")
        if a.vault_only:
            continue
        SITE_DIR.mkdir(parents=True, exist_ok=True)
        ok, err = make_pdf(repo / "README.md", title, SITE_DIR / f"{title}.pdf")
        if ok:
            made.add(f"{title}.pdf")
            print(f"  pdf    {title}.pdf")
        else:
            print(f"FAIL  {title}: {err}")
    if a.vault_only:
        return
    if SITE_DIR.is_dir():
        for old in sorted(SITE_DIR.glob("*.pdf")):
            if old.name not in made:
                subprocess.run(["gio", "trash", str(old)])
                print(f"  removed (repo no longer exists): {old.name}")
    if made:
        cp.build_site(cp.REPO)
        if not a.no_push:
            cp.publish(cp.REPO, "Laborbuch")


if __name__ == "__main__":
    main()
